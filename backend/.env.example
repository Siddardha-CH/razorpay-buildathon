# Copy this file to `.env` (same folder) and fill in real values there.
# `.env` is git-ignored at the repo root -- never commit real secrets.
# Every line here is optional; the pipeline runs fully in simulated/offline
# mode with all of these left blank.

# Enables LLM-assisted narration of ambiguous checkout-abandonment reasons.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Enables the real Razorpay test-mode Payment Links gateway instead of the
# built-in simulator. Get test-mode keys from your Razorpay Dashboard ->
# Settings -> API Keys (make sure you're in Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared secret the frontend must send as the X-API-Key header to trigger a
# batch run. Change this from the default if you ever expose this beyond
# your own machine.
RECOUP_API_KEY=dev-local-key
